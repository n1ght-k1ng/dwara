{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noPropertyAccessFromIndexSignature": true,

    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "baseUrl": ".",
    "paths": {
      "@dwara/core": ["./packages/core/src/index.ts"],
      "@dwara/tools": ["./packages/tools/src/index.ts"],
      "@dwara/mcp-server": ["./packages/mcp-server/src/index.ts"],
      "@dwara/cli": ["./packages/cli/src/index.ts"],
      "@dwara/hook": ["./packages/hook/src/index.ts"]
    }
  }
}
