# lab-api / lab-staging extras: nginx validation, reload, and config reads.
# edit_config reads with `cat --` and writes the whole file with `tee --`,
# so both forms are spelled out. The `--` matters: it is a separate argument
# and a rule written without it does not match the command.
Cmnd_Alias DWARA_NGINX = /usr/sbin/nginx -t,     \
                         /usr/sbin/nginx -T,     \
                         /usr/sbin/nginx -s reload, \
                         /usr/bin/cat /etc/nginx/*, \
                         /usr/bin/cat -- /etc/nginx/*, \
                         /usr/bin/tee -- /etc/nginx/*

dwara ALL=(root) NOPASSWD: DWARA_NGINX

# No docker rules here, deliberately. The `dwara` user is in the `docker` group,
# so every docker command already runs with the daemon's full authority and none
# of the Phase 2 docker tools use sudo at all. A sudoers rule for `docker image
# prune` would look like a constraint and be none: the same command succeeds
# without sudo. Membership of the docker group is root-equivalent, and that is a
# property of the lab's shape rather than something this file can fix.
#
# So the limits on what Dwara does with docker live in Dwara's code -- the tool
# never builds `prune -a`, and the registry refuses a mutating tool that cannot
# roll back -- not here.
