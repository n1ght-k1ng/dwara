# Dwara lab: passwordless sudo for the dwara user, allowlisted commands only.
# Installed to /etc/sudoers.d/dwara-common. Lab-only; see testbed/README.md.

Cmnd_Alias DWARA_SYSTEMD = /usr/bin/systemctl status *,      \
                           /usr/bin/systemctl show *,        \
                           /usr/bin/systemctl cat *,         \
                           /usr/bin/systemctl is-active *,   \
                           /usr/bin/systemctl is-enabled *,  \
                           /usr/bin/systemctl is-failed *,   \
                           /usr/bin/systemctl is-system-running, \
                           /usr/bin/systemctl list-units *,  \
                           /usr/bin/systemctl list-unit-files *, \
                           /usr/bin/systemctl daemon-reload, \
                           /usr/bin/systemctl start *,       \
                           /usr/bin/systemctl stop *,        \
                           /usr/bin/systemctl restart *,     \
                           /usr/bin/systemctl reload *,     \
                           /usr/bin/systemctl reset-failed *

Cmnd_Alias DWARA_LOGS    = /usr/bin/journalctl *

Cmnd_Alias DWARA_INSPECT = /usr/bin/ss *,      \
                           /usr/bin/du *,      \
                           /usr/bin/df *,      \
                           /usr/bin/find /var/log *, \
                           /usr/bin/stat *,    \
                           /usr/bin/sha256sum *

# Read-only audit of the effective sshd configuration. `sshd -T` needs root to
# read the host keys it validates, and is the kind of read-only check a real ops
# sudoers grants. Reading /etc/sudoers.d itself is deliberately NOT granted:
# read_config's deny-list refuses those paths, and security_audit must not be a
# way around it.
Cmnd_Alias DWARA_AUDIT   = /usr/sbin/sshd -T

# read_config. Some service configuration is mode 0640 and unreadable without
# root -- redis.conf is root:redis, for one -- so the read needs sudo. The rule
# is written to match exactly the command read_config builds, including the
# refusal to follow a symlink, rather than granting `find` or `cat` generally.
Cmnd_Alias DWARA_READCONF = /usr/bin/find /etc/* -maxdepth 0 -type f ! -type l -exec cat {} +

# Snapshots. The destination is pinned inside the snapshot store in every rule
# that writes, which is only possible because the manager copies one file per
# `cp`: a batched copy takes a variable number of sources, and the rule would
# then have to end in a bare `*` -- a grant to copy anything anywhere as root.
#
# The sources are deliberately narrow. /etc and /var/log are where service
# configuration and logs live, and nothing else is worth snapshotting.
Cmnd_Alias DWARA_SNAPSHOT = /usr/bin/mkdir -p -- /var/lib/dwara/snapshots/*,        \
                            /usr/bin/cp --preserve=all --parents -- /etc/* /var/lib/dwara/snapshots/*, \
                            /usr/bin/cp --preserve=all --parents -- /var/log/* /var/lib/dwara/snapshots/*, \
                            /usr/bin/cp --preserve=all -- /var/lib/dwara/snapshots/* /etc/*, \
                            /usr/bin/cp --preserve=all -- /var/lib/dwara/snapshots/* /var/log/*, \
                            /usr/bin/tee -- /var/lib/dwara/snapshots/*, \
                            /usr/bin/cat -- /var/lib/dwara/snapshots/*

# Retention, written out in full rather than as `find /var/lib/dwara/snapshots *`.
# A wildcard tail would permit `-exec rm -rf /etc {} +`, because find substitutes
# {} into an argument list the caller controls. These three forms are the only
# ones Dwara issues, and the single wildcard in each sits where find treats it as
# a basename pattern or an mtime, never as a path.
Cmnd_Alias DWARA_RETAIN = /usr/bin/find /var/lib/dwara/snapshots -mindepth 1 -maxdepth 1 -type d -printf *, \
                          /usr/bin/find /var/lib/dwara/snapshots -mindepth 1 -maxdepth 1 -type d -mtime * -exec rm -rf {} +, \
                          /usr/bin/find /var/lib/dwara/snapshots -mindepth 1 -maxdepth 1 -type d -name * -exec rm -rf {} +

# rotate_logs. One file per invocation, so the rule can pin the directory --
# the same reason the snapshot copies one file per `cp`.
#
# No logrotate rule: the tool does not use it. logrotate only acts on files it
# already has a configuration for, and a file with a working rule is rarely the
# one that filled the disk; the runaway writer nobody configured is.
Cmnd_Alias DWARA_ROTATE = /usr/bin/truncate -s 0 -- /var/log/*

dwara ALL=(root) NOPASSWD: DWARA_SYSTEMD, DWARA_LOGS, DWARA_INSPECT, DWARA_AUDIT, DWARA_READCONF, \
                           DWARA_SNAPSHOT, DWARA_RETAIN, DWARA_ROTATE
Defaults:dwara !requiretty
