# Single-node KRaft broker for the lab. Plaintext only; testbed values.
#
# Listeners bind to the routable lab-queue address rather than 0.0.0.0: the
# apache/kafka entrypoint formats storage before launch and rejects a
# non-routable advertised address at that step. The broker runs with host
# networking inside lab-queue, so this is the host's own interface.
KAFKA_NODE_ID=1
KAFKA_PROCESS_ROLES=broker,controller
KAFKA_LISTENERS=PLAINTEXT://lab-queue:9092,CONTROLLER://lab-queue:9093
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://lab-queue:9092
KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT
KAFKA_INTER_BROKER_LISTENER_NAME=PLAINTEXT
KAFKA_CONTROLLER_QUORUM_VOTERS=1@lab-queue:9093
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1
KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS=0
KAFKA_NUM_PARTITIONS=1
KAFKA_AUTO_CREATE_TOPICS_ENABLE=true
KAFKA_LOG_DIRS=/var/lib/kafka/data
CLUSTER_ID=dwara-lab-cluster-0001
