# SSH config for the Dwara **benchmark baseline** only.
#
# GENERATED by testbed/scripts/gen-baseline-config.sh from testbed/ssh_config.
# Edit that file, then re-run the script.
#
# Same hosts and ports, a different login: `baseline`, which has unrestricted
# root. Dwara never uses this file. It exists so baseline mode means what it says
# -- an agent with raw SSH and no safety layer -- and so the comparison the whole
# benchmark rests on has something to measure. A baseline confined to Dwara's own
# pinned sudoers list cannot take a destructive action even when it decides to.


Host lab-*
  HostName 127.0.0.1
  User baseline
  IdentityFile testbed/.keys/baseline_lab
  IdentitiesOnly yes
  BatchMode yes
  PasswordAuthentication no
  StrictHostKeyChecking accept-new
  UserKnownHostsFile testbed/.keys/known_hosts
  LogLevel ERROR
  ConnectTimeout 5
  ServerAliveInterval 15

Host lab-api
  Port 2201

Host lab-db
  Port 2202

Host lab-cache
  Port 2203

Host lab-queue
  Port 2204

Host lab-staging
  Port 2205
