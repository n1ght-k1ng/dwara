# dependencies
node_modules/
.pnpm-store/

# build output
dist/
*.tsbuildinfo
coverage/

# dwara local state (never commit policy-local state, audit logs, or keys)
.dwara/
testbed/.keys/

# planning archive (contents live in docs/)
dwara-plan.zip

# editor / OS
.DS_Store
*.swp
.idea/
.vscode/

# env
.env
.env.*
!.env.example

# The plugin bundles a copy of the hook at build time; the source is in packages/hook.
packages/plugin-claude-code/hook/

# Benchmark run artefacts. Each run writes a generated mcp.json and ssh_config
# holding absolute paths from the machine it ran on, so the directory is local
# scratch. Published results are committed deliberately, not by sweeping this up.
evals/results/

# Built into the single publishable package from the repo root; not sources.
packages/dwara/plugin/
packages/dwara/README.md
packages/dwara/LICENSE
