{
  "name": "@dwara/mcp-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "MCP stdio adapter over Dwara core",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@dwara/core": "workspace:*",
    "@dwara/tools": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "zod": "^4.6.5"
  },
  "bin": {
    "dwara-mcp": "./dist/index.js"
  }
}
