{
  "name": "dwara",
  "version": "0.0.0",
  "private": true,
  "description": "Policy-controlled SSH access for AI coding agents",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "dwara": "./dist/cli.js",
    "dwara-mcp": "./dist/mcp.js",
    "dwara-hook": "./dist/hook.js"
  },
  "files": [
    "dist",
    "plugin",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup && node scripts/bundle-plugin.mjs",
    "clean": "rm -rf dist plugin *.tsbuildinfo",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "commander": "^14.0.3",
    "execa": "^9.6.1",
    "shell-quote": "^1.10.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@dwara/cli": "workspace:*",
    "@dwara/hook": "workspace:*",
    "@dwara/mcp-server": "workspace:*",
    "@dwara/plugin-claude-code": "workspace:*"
  }
}
