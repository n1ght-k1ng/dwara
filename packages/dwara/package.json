{
  "name": "dwara",
  "version": "0.1.1",
  "description": "Policy-controlled SSH access for AI coding agents",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ssh",
    "ai-agent",
    "claude-code",
    "sre",
    "devops",
    "policy",
    "audit-log"
  ],
  "license": "AGPL-3.0-or-later",
  "author": "Nikhil Reddy",
  "homepage": "https://github.com/n1ght-k1ng/dwara#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/n1ght-k1ng/dwara.git",
    "directory": "packages/dwara"
  },
  "bugs": {
    "url": "https://github.com/n1ght-k1ng/dwara/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "dwara": "./dist/cli.js",
    "dwara-mcp": "./dist/mcp.js",
    "dwara-hook": "./dist/hook.js"
  },
  "files": [
    "dist",
    "plugin",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && node scripts/bundle-plugin.mjs",
    "clean": "rm -rf dist plugin *.tsbuildinfo",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "commander": "^14.0.3",
    "execa": "^9.6.1",
    "shell-quote": "^1.10.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@dwara/cli": "workspace:*",
    "@dwara/hook": "workspace:*",
    "@dwara/mcp-server": "workspace:*",
    "@dwara/plugin-claude-code": "workspace:*"
  }
}
